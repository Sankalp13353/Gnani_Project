# CallSaar Server Environment Configuration

# Server Port (default: 5001, avoiding macOS AirPlay on 5000)
PORT=5001

# Node Environment (development | production | test)
NODE_ENV=development

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/callsaar_db?schema=public"

# Gnani Prisma Speech-to-Text v3 Configuration
GNANI_API_KEY_ID="your_gnani_api_key_id_here"
GNANI_STT_URL="https://api.vachana.ai/stt/v3"
GNANI_MODEL="prisma-v3.0"
GNANI_LANGUAGE_CODE="indic-auto"
GNANI_TIMEOUT_MS=15000
MAX_AUDIO_SIZE_BYTES=10485760

# Authentication Configuration
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="callsaar_token"

